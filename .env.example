POSTGRES_DB=mini_soc
POSTGRES_USER=mini_soc
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change_me

# T5 automatic response (non-secret). Keep RESPONSE_EXECUTE empty/false until the victim is verified.
# RESPONSE_ALLOWLIST: comma-separated IPs or CIDRs never blocked (e.g. the monitoring server).
RESPONSE_EXECUTE=
RESPONSE_ALLOWLIST=
RESPONSE_VICTIM_HOST=
RESPONSE_VICTIM_USER=
RESPONSE_VICTIM_SSH_PORT=22
# Path to a private key mounted into the backend container; never commit the key itself.
RESPONSE_SSH_KEY_PATH=

# T2-B collector port binding on the host (default loopback). A LAN address is needed only
# after the victim network path is verified.
COLLECTOR_BIND=127.0.0.1
